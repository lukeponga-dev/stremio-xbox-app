<Page
    x:Class="StremioXboxPrototype.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StremioXboxPrototype.Controls"
    xmlns:local="using:StremioXboxPrototype"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="HomeGridItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalCatalogItemsPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="PosterTemplate">
            <controls:PosterCard Item="{Binding}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ContinueItemsPanel"><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <Style x:Key="ContinueWatchingItemStyle" TargetType="GridViewItem">
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="#00AFFF" />
            <Setter Property="FocusVisualSecondaryBrush" Value="#00AFFF" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <DataTemplate x:Key="ContinueWatchingTemplate">
            <Border Width="380" Height="126" Margin="0,6,18,10" Padding="10" CornerRadius="12"
                    Background="{StaticResource PanelBrush}" BorderBrush="#30465D" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="94" Height="106" CornerRadius="8" Background="#202A38">
                        <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{Binding WatchProgress.RemainingText}" FontSize="15" Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding WatchProgress.Percent}" Foreground="#00AFFF" Background="#667080" />
                        <TextBlock Text="Resume watching" FontSize="14" Foreground="{StaticResource AccentTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SkeletonTemplate">
            <StackPanel Width="240" Padding="12,14,12,0" Spacing="18" Height="446" AutomationProperties.Name="Loading title">
                <Border Height="324" CornerRadius="14" Background="{StaticResource PanelHoverBrush}" />
                <Border Height="20" Width="160" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource PanelBrush}" />
                <Border Height="14" Width="110" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource PanelBrush}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="AddonCardItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="#00AFFF" />
            <Setter Property="FocusVisualPrimaryThickness" Value="4" />
            <Setter Property="FocusVisualSecondaryThickness" Value="3" />
        </Style>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" XYFocusKeyboardNavigation="Enabled" KeyDown="MainPageKeyDown" SizeChanged="ViewportSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarSurface" Visibility="Collapsed" Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="12,24,12,20"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="BrandHomeButton" Grid.Row="0" Style="{StaticResource IconRailBrandButtonStyle}"
                        Click="ShowHome" ToolTipService.ToolTip="OpenStream TV Home" AutomationProperties.Name="OpenStream TV Home">
                    <TextBlock Text="OPENSTREAM TV" FontFamily="{StaticResource HeadingFont}" FontSize="16" FontWeight="Bold" Foreground="#171B22" />
                </Button>
                <ScrollViewer Grid.Row="1" Margin="0,24,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <Button x:Name="HomeButton" Style="{StaticResource SelectedIconRailButtonStyle}" Click="ShowHome"
                                ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
                            <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="23" /><TextBlock Text="Home" VerticalAlignment="Center" FontSize="16" /></StackPanel>
                        </Button>
                        <Button x:Name="DiscoverButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowDiscover"
                                ToolTipService.ToolTip="Discover" AutomationProperties.Name="Discover">
                            <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="23" /><TextBlock Text="Search" VerticalAlignment="Center" FontSize="16" /></StackPanel>
                        </Button>
                        <Button x:Name="LibraryNavButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowLibrary"
                                ToolTipService.ToolTip="Library" AutomationProperties.Name="Library">
                            <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="23" /><TextBlock Text="Library" VerticalAlignment="Center" FontSize="16" /></StackPanel>
                        </Button>
                        <Button x:Name="AddonsButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowAddons"
                                ToolTipService.ToolTip="Add-ons" AutomationProperties.Name="Add-ons">
                            <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="23" /><TextBlock Text="Add-ons" VerticalAlignment="Center" FontSize="16" /></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="14">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowSettings"
                            ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="23" /><TextBlock Text="Settings" VerticalAlignment="Center" FontSize="16" /></StackPanel>
                    </Button>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="8" HorizontalAlignment="Center">
                        <StackPanel Spacing="7" AutomationProperties.Name="A Select, B Back, Y Search">
                            <TextBlock Text="A" Style="{StaticResource ControllerHintTextStyle}" />
                            <TextBlock Text="B" Style="{StaticResource ControllerHintTextStyle}" />
                            <TextBlock Text="Y" Style="{StaticResource ControllerHintTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ContentSurface" Grid.Column="1" Background="{StaticResource HomeSurfaceBrush}" Padding="36,8,36,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="MainHeader" Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HeaderActionsColumn" Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource FocusBloomBrush}">
                            <FontIcon Glyph="&#xE768;" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TopBrandText" Text="OpenStream TV" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="TopHomeButton" Content="Home" Style="{StaticResource TopNavSelectedButtonStyle}" Click="ShowHome" PointerEntered="TopNavigationPointerEntered" Margin="0,0,2,0" />
                        <Button x:Name="TopSearchButton" Content="Discover" Style="{StaticResource TopNavButtonStyle}" Click="ShowDiscover" PointerEntered="TopNavigationPointerEntered" Margin="2,0" />
                        <Button x:Name="TopLibraryButton" Content="Library" Style="{StaticResource TopNavButtonStyle}" Click="ShowLibrary" PointerEntered="TopNavigationPointerEntered" Margin="2,0" />
                        <Button x:Name="TopAddonsButton" Content="Add-ons" Style="{StaticResource TopNavButtonStyle}" Click="ShowAddons" PointerEntered="TopNavigationPointerEntered" Margin="2,0" />
                        <Button x:Name="TopSettingsButton" Content="Settings" Style="{StaticResource TopNavButtonStyle}" Click="ShowSettings" PointerEntered="TopNavigationPointerEntered" Margin="2,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="TopProfileButton" Style="{StaticResource HomeHeaderButtonStyle}" Width="58" Height="54" Click="ShowAccount" VerticalAlignment="Center" PointerEntered="TopNavigationPointerEntered" AutomationProperties.Name="Profile"><FontIcon Glyph="&#xE77B;" FontSize="25" /></Button>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="HeaderText" Grid.Row="1" Spacing="6" Margin="0,0,24,0">

                    <TextBlock x:Name="PageTitle" Text="Discover something great to watch today" FontFamily="{StaticResource HeadingFont}" FontSize="34" LineHeight="52" CharacterSpacing="-20" FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitle" Text="Pick up where you left off or find your next favourite" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                    <ProgressRing x:Name="BusyIndicator" Width="28" Height="28" IsActive="False" />
                    <Button x:Name="HomeRefreshButton" Visibility="Collapsed" IsTabStop="False" Style="{StaticResource HomeHeaderButtonStyle}" Click="RetryHome" AutomationProperties.Name="Refresh popular titles">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="20" /><TextBlock Text="Refresh" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="HeaderSearchButton" Visibility="Collapsed" Style="{StaticResource HomeHeaderButtonStyle}" Click="ShowDiscover" AutomationProperties.Name="Open search">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="20" /><TextBlock Text="Search" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="AccountButton" Visibility="Collapsed" Style="{StaticResource HomeHeaderButtonStyle}" Click="ShowAccount">
                        <Grid>
                            <TextBlock x:Name="AccountNavLabel" Text="Login" Margin="0,0,28,0" VerticalAlignment="Center" />
                            <Border x:Name="ProfileInitialBadge" Width="23" Height="23" CornerRadius="12" HorizontalAlignment="Right" Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="ProfileInitialText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid x:Name="HomePanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="HomeConnectionNotice" Visibility="Collapsed" Style="{StaticResource SurfaceBorderStyle}" Padding="12,4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="HomeConnectionText" Text="Playback server offline"
                                       FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Details" Style="{StaticResource HeaderButtonStyle}" Click="ShowConnectionDetails" />
                                <Button x:Name="HomeReconnectButton" Content="Reconnect" Style="{StaticResource HeaderButtonStyle}" Click="ReconnectServer" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="HomeShelves" XYFocusKeyboardNavigation="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                            <StackPanel Spacing="14">
                                <Border x:Name="FeaturedHero" Height="285" CornerRadius="16" Background="#101B28" BorderBrush="#243447" BorderThickness="1" Margin="0,0,0,0">
                                    <Grid>
                                        <Image x:Name="FeaturedArtwork" Stretch="UniformToFill" Opacity="0.96" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#F5070B10" Offset="0" />
                                                    <GradientStop Color="#E8070B10" Offset="0.42" />
                                                    <GradientStop Color="#55070B10" Offset="0.72" />
                                                    <GradientStop Color="#08070B10" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <StackPanel Margin="22,12,0,12" VerticalAlignment="Center" MaxWidth="610" Spacing="5">
                                            <TextBlock Text="FEATURED FOR YOU" FontSize="14" CharacterSpacing="170" Foreground="#B8D3F2" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FeaturedTitleText" Text="Discover something great to watch today" FontFamily="{StaticResource HeadingFont}" FontSize="38" FontWeight="Bold" Foreground="#F5F8FC" TextWrapping="Wrap" MaxLines="2" />
                                            <TextBlock x:Name="FeaturedMetadataText" Text="Discover movies and series from your configured add-ons." FontSize="17" Foreground="#D0DDED" TextWrapping="Wrap" />
                                            <TextBlock x:Name="FeaturedDescriptionText" Text="Your next favourite is waiting." FontSize="17" Foreground="#D0DDED" TextWrapping="Wrap" MaxLines="2" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                                                <Button x:Name="FeaturedPlayButton" Content="Play" Style="{StaticResource FeaturedPlayButtonStyle}" Width="190" Click="OpenFeaturedItem" />
                                                <Button x:Name="FeaturedDetailsButton" Content="More info" Style="{StaticResource HeaderButtonStyle}" Width="160" Click="OpenFeaturedItem" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18" Spacing="12">
                                            <Ellipse Width="10" Height="10" Fill="#F5F8FC" /><Ellipse Width="10" Height="10" Fill="#708092" /><Ellipse Width="10" Height="10" Fill="#708092" /><Ellipse Width="10" Height="10" Fill="#708092" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="ContinueWatchingShelf" Visibility="Collapsed" Margin="0,0,0,10">
                                    <Button x:Name="ContinueWatchingHeader" Content="Continue Watching" Style="{StaticResource HomeSectionHeaderButtonStyle}" Click="ShowLibrary" HorizontalAlignment="Left" />
                                    <GridView x:Name="ContinueWatchingGrid" Height="160" XYFocusKeyboardNavigation="Enabled" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource ContinueItemsPanel}" ItemTemplate="{StaticResource ContinueWatchingTemplate}"
                                              ItemContainerStyle="{StaticResource ContinueWatchingItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Margin="0,0,12,0">
                                        <Button x:Name="RecommendedHeader" Content="Discover" Style="{StaticResource HomeSectionHeaderButtonStyle}" Click="ShowMovieCatalog" HorizontalAlignment="Left" />
                                     </Grid>
                                    <GridView x:Name="MovieGrid"  XYFocusKeyboardNavigation="Enabled" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource HomeGridItemsPanel}" ItemTemplate="{StaticResource PosterTemplate}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                                <StackPanel x:Name="TrendingMoviesShelf">
                                    <Button x:Name="TrendingMoviesHeader" Content="Trending" Style="{StaticResource HomeSectionHeaderButtonStyle}" Click="ShowMovieCatalog" HorizontalAlignment="Left" />
                                    <GridView x:Name="TrendingMoviesGrid"  XYFocusKeyboardNavigation="Enabled" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource HomeGridItemsPanel}" ItemTemplate="{StaticResource PosterTemplate}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                                <StackPanel x:Name="PopularSeriesShelf" Visibility="Collapsed">
                                    <Grid Margin="0,0,12,0">
                                        <Button x:Name="PopularSeriesHeader" Content="Popular Series" Style="{StaticResource HomeSectionHeaderButtonStyle}" Click="ShowSeriesCatalog" HorizontalAlignment="Left" />
                                     </Grid>
                                    <GridView x:Name="SeriesGrid"  XYFocusKeyboardNavigation="Enabled" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource HomeGridItemsPanel}" ItemTemplate="{StaticResource PosterTemplate}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                             </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="HomeLoadingPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="14">
                                        <TextBlock Text="Finding something good to watch..." FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel>
                                    <TextBlock Text="Popular movies" Style="{StaticResource SectionTitleStyle}" />
                                    <ItemsControl x:Name="MovieSkeletons" ItemTemplate="{StaticResource SkeletonTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Popular series" Style="{StaticResource SectionTitleStyle}" />
                                    <ItemsControl x:Name="SeriesSkeletons" ItemTemplate="{StaticResource SkeletonTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel x:Name="HomeUnavailablePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" MaxWidth="660">
                            <TextBlock x:Name="HomeStateTitle" Text="We couldn't load your movies and series" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="HomeStateText" Text="Check your internet connection, then try again." FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            <Button Content="Try again" Style="{StaticResource PrimaryButtonStyle}" Click="RetryHome" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid x:Name="DiscoverPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SearchInputGrid">
                        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search movies and series" KeyDown="SearchBoxKeyDown" AutomationProperties.Name="Search movies and series" InputScope="Search" />
                        <Button x:Name="SearchSubmitButton" Grid.Column="1" Content="Search" Margin="12,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Search" />
                        <Button x:Name="KeyboardButton" Grid.Column="2" Width="60" Margin="12,0,0,0" Style="{StaticResource SearchToolButtonStyle}" Click="ToggleSearchKeyboard" AutomationProperties.Name="On-screen keyboard" ToolTipService.ToolTip="On-screen keyboard">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE765;" FontSize="23" />
                        </Button>
                        <Button x:Name="VoiceSearchButton" Grid.Column="3" Width="60" Margin="12,0,0,0" Style="{StaticResource SearchToolButtonStyle}" Click="VoiceSearch" AutomationProperties.Name="Voice search" ToolTipService.ToolTip="Voice search">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;" FontSize="23" />
                        </Button>
                    </Grid>
                    <Border x:Name="SearchKeyboardPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource SurfaceBorderStyle}" Padding="12" Margin="0,16,0,0" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="KeyboardRows" Spacing="6" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="DiscoverStatusText" Grid.Row="2" Text="Find something great to watch. Search a title or explore a collection below." FontSize="18" Margin="0,12,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    <ScrollViewer x:Name="DiscoverSuggestions" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="22" Margin="0,10,0,18">
                            <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="DISCOVER SOMETHING NEW" FontSize="14" FontWeight="Bold" CharacterSpacing="150" Foreground="{StaticResource SecondaryBrush}" />
                                        <TextBlock Text="Your next favourite starts here." FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="Explore films and series from the catalogues provided by your installed add-ons." FontSize="18" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="760" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="104" Height="104" CornerRadius="18" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;" FontSize="46" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Browse by category" FontSize="24" FontWeight="SemiBold" />
                                <Grid x:Name="DiscoverCategoryGrid" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="DiscoverAllCategoryButton" Grid.Column="0" Tag="all" Content="All titles" MinHeight="58" Style="{StaticResource PrimaryButtonStyle}" Click="DiscoverCategoryClick" />
                                    <Button x:Name="DiscoverMoviesCategoryButton" Grid.Column="1" Tag="movie" Content="Movies" MinHeight="58" Style="{StaticResource TvButtonStyle}" Click="DiscoverCategoryClick" />
                                    <Button x:Name="DiscoverSeriesCategoryButton" Grid.Column="2" Tag="series" Content="TV shows" MinHeight="58" Style="{StaticResource TvButtonStyle}" Click="DiscoverCategoryClick" />
                                    <Button x:Name="DiscoverAnimeCategoryButton" Grid.Column="3" Tag="Anime" Content="Anime" MinHeight="58" Style="{StaticResource TvButtonStyle}" Click="DiscoverCategoryClick" />
                                    <Button x:Name="DiscoverDocsCategoryButton" Grid.Column="4" Tag="Documentaries" Content="Documentaries" MinHeight="58" Style="{StaticResource TvButtonStyle}" Click="DiscoverCategoryClick" />
                                    <Button x:Name="DiscoverKidsCategoryButton" Grid.Column="5" Tag="Kids" Content="Kids" MinHeight="58" Style="{StaticResource TvButtonStyle}" Click="DiscoverCategoryClick" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Popular collections" FontSize="24" FontWeight="SemiBold" />
                                <StackPanel x:Name="DiscoverBrowseActions" Orientation="Horizontal" Spacing="16">
                                    <Button MinWidth="560" MinHeight="126" HorizontalContentAlignment="Stretch" Style="{StaticResource TvButtonStyle}" Click="ShowMovieCatalog">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="POPULAR MOVIES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" />
                                                <TextBlock Text="Trending films" FontSize="23" FontWeight="Bold" />
                                                <TextBlock Text="Explore the most-watched movies" FontSize="16" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE768;" FontSize="28" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        </Grid>
                                    </Button>
                                    <Button MinWidth="560" MinHeight="126" HorizontalContentAlignment="Stretch" Style="{StaticResource TvButtonStyle}" Click="ShowSeriesCatalog">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="POPULAR SERIES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" />
                                                <TextBlock Text="Binge-worthy shows" FontSize="23" FontWeight="Bold" />
                                                <TextBlock Text="Find your next series to follow" FontSize="16" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE768;" FontSize="28" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>                    <GridView x:Name="DiscoverGrid" Grid.Row="3" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None" ContainerContentChanging="PosterContainerChanging" ItemTemplate="{StaticResource PosterTemplate}" />
                </Grid>
                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,0,16">
                        <TextBlock Text="Local library" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Your saved movies and series"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="18" />
                    </StackPanel>
                    <GridView x:Name="LibraryGrid" ContainerContentChanging="PosterContainerChanging" Margin="0,58,0,0" IsItemClickEnabled="True" ItemClick="OpenItem"
                              SelectionMode="None" ItemTemplate="{StaticResource PosterTemplate}" />
                    <TextBlock x:Name="EmptyLibraryText" Text="Your library is empty. Open a title and choose Add to library." TextWrapping="Wrap"
                               FontSize="22" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer x:Name="PlaybackLabPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <TextBlock Text="Exercise the native Xbox media pipeline with a direct HTTP(S) URL."
                                   FontSize="22" TextWrapping="Wrap" />
                        <TextBox x:Name="DirectUrlBox" Header="Media URL"
                                 Text="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" />
                        <Button Content="Play direct stream" Style="{StaticResource PrimaryButtonStyle}"
                                Width="260" Click="PlayDirectUrl" />
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="22" Margin="0,18,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="This path measures" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="- Media open time and failures&#x0a;- Buffering transitions&#x0a;- Playback end and interruption&#x0a;- App memory usage"
                                           FontSize="19" LineHeight="31" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="AddonsPanel" Visibility="Collapsed" Background="Transparent" Margin="18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Add-ons" FontFamily="{StaticResource HeadingFont}" FontSize="44"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="AddonCountText" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="21"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="AddonSyncAccountButton" Content="⟳  Sync Add-ons"
                                    Style="{StaticResource HeaderButtonStyle}" Click="SyncAddonsFromPage"
                                    AutomationProperties.Name="Sync installed add-ons" />
                            <Button x:Name="AddProviderButton" Content="⇧  Import Manifest"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="ToggleAddProviderForm"
                                    AutomationProperties.Name="Import add-on manifest" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <Border x:Name="AddProviderForm" Visibility="Collapsed" Background="#101A28"
                                    BorderBrush="#34465C" BorderThickness="1" CornerRadius="14" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Import stream add-on manifest" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="Paste compatible add-on manifest URLs. Providers are validated before they are saved."
                                               FontSize="16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <TextBox x:Name="AddonUrlsBox" Header="Manifest URLs" PlaceholderText="https://example.com/manifest.json"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="130" />
                                    <StackPanel x:Name="AddonImportActions" Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="SaveProvidersButton" Content="Import providers" Style="{StaticResource PrimaryButtonStyle}" Click="SaveAddons" />
                                        <Button x:Name="SyncProvidersButton" Content="Sync from Stremio account" Style="{StaticResource TvButtonStyle}" Click="ShowAccount" />
                                    </StackPanel>
                                    <TextBlock x:Name="AddonSaveStatus" FontSize="16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AddonSummaryText" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" Margin="2,0,0,0" />
                            <ListView x:Name="AddonCards" IsItemClickEnabled="True" ItemClick="AddonTileClicked"
                                      SelectionMode="None" Background="Transparent" BorderThickness="0"
                                      HorizontalAlignment="Stretch" Loaded="AddonGridHostLoaded"
                                      ItemContainerStyle="{StaticResource AddonCardItemStyle}"
                                      PointerMoved="AddonCardsPointerMoved"
                                      XYFocusKeyboardNavigation="Enabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:AddonCardView">
                                        <Border Background="#111C2A" BorderBrush="#30445B" BorderThickness="1"
                                                CornerRadius="14" Padding="14,10" Margin="0,0,0,7" MinHeight="88">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="62" Height="62" Background="#17283B"
                                                        BorderBrush="#38516D" BorderThickness="1" CornerRadius="12"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;"
                                                                  FontSize="26" Foreground="#8CCFFF"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind LogoSource}" Stretch="Uniform" Margin="6" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="21" FontWeight="Bold"
                                                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="14"
                                                               Foreground="#B8CBE1" TextTrimming="CharacterEllipsis"
                                                               MaxLines="2" />
                                                    <TextBlock Text="{x:Bind CategoryLine}" FontSize="12"
                                                               Foreground="#819BB6" TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{x:Bind StatusBackground}"
                                                        BorderBrush="{x:Bind StatusForeground}" BorderThickness="1"
                                                        CornerRadius="12" Padding="11,6"
                                                        VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{x:Bind StatusForeground}" VerticalAlignment="Center" />
                                                </Border>
                                                <Button Grid.Column="3" Content="•••" Tag="{x:Bind}"
                                                        Visibility="{x:Bind RemoveVisibility}"
                                                        Style="{StaticResource AddonCardActionStyle}"
                                                        BorderBrush="#53657B" BorderThickness="1"
                                                        Padding="8,8" MinWidth="50" MinHeight="46"
                                                        AutomationProperties.Name="More options and remove provider"
                                                        Click="RemoveAddonCard" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="AddonEmptyDetail" Visibility="Collapsed" FontSize="17"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer x:Name="ServerPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="22">
                        <TextBlock Text="Streaming" FontSize="32" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="30" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Caching" FontSize="20" VerticalAlignment="Center" />
                            <ComboBox x:Name="StreamingCacheCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="StreamingCacheChanged" AutomationProperties.Name="Caching">
                                <ComboBoxItem Content="512MB" />
                                <ComboBoxItem Content="1GB" />
                                <ComboBoxItem Content="2GB" />
                                <ComboBoxItem Content="4GB" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Enable the local files add-on (requires restart)" FontSize="20"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="LocalFilesAddonToggle" Grid.Row="1" Grid.Column="1"
                                          HorizontalAlignment="Left" Toggled="LocalFilesAddonChanged"
                                          AutomationProperties.Name="Enable local files add-on" />

                            <TextBlock Grid.Row="2" Text="Enable remote HTTPS connections" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="RemoteHttpsCombo" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="RemoteHttpsChanged" AutomationProperties.Name="Remote HTTPS connections">
                                <ComboBoxItem Content="Disabled" />
                                <ComboBoxItem Content="Enabled" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Torrent Profile" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="TorrentProfileCombo" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="TorrentProfileChanged" AutomationProperties.Name="Torrent profile">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="Fast start" />
                                <ComboBoxItem Content="Data saver" />
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Server" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServerConnectionState" Grid.Row="4" Grid.Column="1" Text="Checking..." FontSize="20"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Text="Streaming server URL:" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="StreamingServerUrlText" Grid.Row="5" Grid.Column="1" TextTrimming="CharacterEllipsis"
                                       FontSize="18" VerticalAlignment="Center" />
                            <Button Grid.Row="5" Grid.Column="2" Content="Copy" Style="{StaticResource TvButtonStyle}"
                                    Click="CopyStreamingServerUrl" AutomationProperties.Name="Copy streaming server URL" />
                        </Grid>

                        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Playback server" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Your server handles torrent-backed playback. Render-hosted servers should use the public HTTPS URL without port 12470."
                                           FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="StreamingServiceUrlBox" Header="Streaming service URL"
                                         PlaceholderText="https://your-service.example/" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button x:Name="ConnectServerButton" Content="Connect and save" Style="{StaticResource PrimaryButtonStyle}"
                                            Width="230" Click="SaveStreamingService" />
                                    <Button Content="Disconnect server" Style="{StaticResource TvButtonStyle}" Click="DisconnectServer" />
                                </StackPanel>
                                <TextBlock x:Name="StreamingServiceStatus" FontSize="18"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <StackPanel x:Name="SignedOutAccountContent" Spacing="18">
                            <TextBlock Text="OpenStream TV is an independent application. It is not affiliated with or endorsed by Stremio. Stremio account and add-on compatibility is provided through third-party services." FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="OpenStream TV is an independent application. It is not affiliated with or endorsed by Stremio. Stremio account and add-on compatibility is provided through third-party services." FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Connect directly to Stremio at api.strem.io. Your password is sent only to Stremio for login; the returned session key is stored in Windows Credential Locker and verified when the app starts."
                                       FontSize="20" TextWrapping="Wrap" />
                            <Button Content="Continue with Facebook" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="300" Click="SignInWithFacebook" />
                            <TextBlock Text="Facebook sign-in opens Stremio's secure sign-in page in Microsoft Edge. Finish there, then return to this app. Your Facebook password is never entered into this app."
                                       FontSize="20" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Or sign in with email" FontSize="20" FontWeight="SemiBold" />
                            <TextBox x:Name="AccountEmailBox" Header="Stremio email" InputScope="EmailSmtpAddress" />
                            <PasswordBox x:Name="AccountPasswordBox" Header="Password" />
                            <Button Content="Sign in and sync" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="240" Click="SignInAndSync" />
                        </StackPanel>
                        <StackPanel x:Name="SignedInProfileContent" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="Your Stremio profile" FontSize="26" FontWeight="SemiBold" />
                            <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ProfileEmailText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProfileIdText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProfileAddonCountText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                            <Button x:Name="SyncAddonsButton" Content="Sync add-ons" Style="{StaticResource TvButtonStyle}"
                                    Width="210" Click="SyncAccountAddons" />
                            <Button Content="Sign out" Style="{StaticResource TvButtonStyle}"
                                    Width="160" Click="SignOut" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="AccountStatusBanner" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10">
                            <TextBlock x:Name="AccountStatusText" Text="Not signed in" FontSize="19"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Display and accessibility" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch x:Name="PosterAnimationsToggle" Header="Animate focused posters" OnContent="4% focus zoom" OffContent="Border only" Toggled="PosterAnimationsChanged" FontSize="20" />
                        <TextBlock Text="Turn off zoom animations if you prefer less motion. The bright focus border remains visible." FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <Button Content="Manage Stremio account" Style="{StaticResource TvButtonStyle}" Click="ShowAccount" />
                        <TextBlock Text="Advanced" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Manage your playback server and troubleshooting tools." FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="ServerButton" Content="Playback server" Style="{StaticResource TvButtonStyle}" Click="ShowServer" />
                        <Button x:Name="PlaybackLabButton" Content="Playback Lab" Style="{StaticResource TvButtonStyle}" Click="ShowPlaybackLab" />
                        <Button x:Name="DiagnosticsButton" Content="Diagnostics" Style="{StaticResource TvButtonStyle}" Click="ShowDiagnostics" />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                        <StackPanel Spacing="12"><TextBlock x:Name="MemoryText" Text="Memory: measuring..." FontFamily="Consolas" FontSize="18" /><TextBlock x:Name="NetworkStatusText" Text="Ready" FontSize="18" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <ListView x:Name="DiagnosticsList" Grid.Row="1" ItemsSource="{x:Bind Diagnostics}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#F4F7FB" SelectionMode="None"
                              PointerMoved="AddonCardsPointerMoved">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter Property="Background" Value="#111C2A" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="18"
                                           Foreground="#F4F7FB" TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#E60A1119" BorderBrush="#263648" BorderThickness="0,1,0,0" Padding="4,10" Margin="-50,0,-45,-16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="30" VerticalAlignment="Center" Margin="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="#35E66D" BorderThickness="2"><TextBlock Text="A" Foreground="#35E66D" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="Select" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="#FF4545" BorderThickness="2"><TextBlock Text="B" Foreground="#FF4545" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="Back" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="#FFD12A" BorderThickness="2"><TextBlock Text="Y" Foreground="#FFD12A" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="More Options" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="#258CFF" BorderThickness="2"><TextBlock Text="X" Foreground="#258CFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="View Details" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="All Your Streams. One Place." Foreground="#A8B8CB" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0" />
                </Grid>
            </Border>        </Grid>
    </Grid>

</Page>
