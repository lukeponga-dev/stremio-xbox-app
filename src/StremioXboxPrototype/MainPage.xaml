<Page
    x:Class="StremioXboxPrototype.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="PosterTemplate">
            <Grid Width="184" Height="330" Margin="8,8,20,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="276" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#241F36" CornerRadius="10">
                    <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,12,2,0">
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="12,18,12,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <Image Width="44" Height="44" HorizontalAlignment="Center"
                           Stretch="Uniform" AutomationProperties.Name="Stremio">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/StremioSymbol.svg" />
                        </Image.Source>
                    </Image>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,34,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                        <Button x:Name="HomeButton" ToolTipService.ToolTip="Home" Style="{StaticResource SelectedNavButtonStyle}" Click="ShowHome"><StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="27" /><TextBlock Text="Home" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="DiscoverButton" ToolTipService.ToolTip="Discover" Style="{StaticResource NavButtonStyle}" Click="ShowDiscover"><StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="25" /><TextBlock Text="Discover" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="LibraryNavButton" ToolTipService.ToolTip="My library" Style="{StaticResource NavButtonStyle}" Click="ShowLibrary"><StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="25" /><TextBlock Text="My library" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="PlaybackLabButton" ToolTipService.ToolTip="Playback lab" Style="{StaticResource NavButtonStyle}" Click="ShowPlaybackLab"><StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="25" /><TextBlock Text="Playback lab" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="AddonsButton" ToolTipService.ToolTip="Stream add-ons" Style="{StaticResource NavButtonStyle}" Click="ShowAddons"><StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="25" /><TextBlock Text="Add-ons" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="AccountButton" Style="{StaticResource NavButtonStyle}" Click="ShowAccount">
                            <Grid>
                                <FontIcon HorizontalAlignment="Left" FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="26" />
                                <Border x:Name="ProfileInitialBadge" Width="23" Height="23" CornerRadius="12"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="ProfileInitialText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="AccountNavLabel" Text="Login" Margin="42,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button x:Name="ServerButton" Style="{StaticResource NavButtonStyle}" Click="ShowServer"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;" FontSize="25" /><TextBlock Text="Server" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button x:Name="DiagnosticsButton" ToolTipService.ToolTip="Diagnostics" Style="{StaticResource NavButtonStyle}" Click="ShowDiagnostics"><StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="25" /><TextBlock Text="Diagnostics" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="A  Select     B  Back" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6" Margin="0,0,20,20">
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="36" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Movies and series" FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button x:Name="ServerStatusButton" Grid.Column="1" Content="Server: checking…" Style="{StaticResource TvButtonStyle}" Click="ShowServer" VerticalAlignment="Top" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search movies and series" KeyDown="SearchBoxKeyDown" AutomationProperties.Name="Search movies and series" />
                    <Button Grid.Column="1" Content="Search" Margin="16,0,0,0" Style="{StaticResource TvButtonStyle}" Click="Search" />
                    <ProgressRing x:Name="BusyIndicator" Grid.Column="2" Margin="16,0,0,0" Width="32" Height="32" IsActive="False" />
                </Grid>
            </Grid>
            <TextBlock x:Name="NetworkStatusText" Grid.Row="2" Text="Ready" FontSize="18" Margin="0,12,0,0"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="HomePanel">
                    <StackPanel Spacing="38">
                        <StackPanel>
                            <Grid Margin="0,0,12,0">
                                <TextBlock Text="Movies - Popular" Style="{StaticResource SectionTitleStyle}" />
                                <Button Content="See all  ›" Width="140" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Style="{StaticResource ShelfLinkButtonStyle}" Click="ShowDiscover" />
                            </Grid>
                            <GridView x:Name="MovieGrid" IsItemClickEnabled="True" ItemClick="OpenItem"
                                      SelectionMode="None" ItemsPanel="{StaticResource HorizontalItemsPanel}"
                                      ItemTemplate="{StaticResource PosterTemplate}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>

                        <StackPanel>
                            <Grid Margin="0,0,12,0">
                                <TextBlock Text="Series - Popular" Style="{StaticResource SectionTitleStyle}" />
                                <Button Content="See all  ›" Width="140" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Style="{StaticResource ShelfLinkButtonStyle}" Click="ShowDiscover" />
                            </Grid>
                            <GridView x:Name="SeriesGrid" IsItemClickEnabled="True" ItemClick="OpenItem"
                                      SelectionMode="None" ItemsPanel="{StaticResource HorizontalItemsPanel}"
                                      ItemTemplate="{StaticResource PosterTemplate}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DiscoverPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Search results" Style="{StaticResource SectionTitleStyle}" />
                    <GridView x:Name="DiscoverGrid" Grid.Row="1" Margin="0,24,0,0"
                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                              ItemTemplate="{StaticResource PosterTemplate}" />
                </Grid>

                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,0,16">
                        <TextBlock Text="Local library" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Saved on this Xbox. Cloud library sync will appear here when the account API supports it."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="18" />
                    </StackPanel>
                    <GridView x:Name="LibraryGrid" Margin="0,58,0,0" IsItemClickEnabled="True" ItemClick="OpenItem"
                              SelectionMode="None" ItemTemplate="{StaticResource PosterTemplate}" />
                    <TextBlock x:Name="EmptyLibraryText" Text="Your prototype library is empty. Add a title from its details page."
                               FontSize="22" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer x:Name="PlaybackLabPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <TextBlock Text="Exercise the native Xbox media pipeline with a direct HTTP(S) URL."
                                   FontSize="22" TextWrapping="Wrap" />
                        <TextBox x:Name="DirectUrlBox" Header="Media URL"
                                 Text="https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" />
                        <Button Content="Play direct stream" Style="{StaticResource PrimaryButtonStyle}"
                                Width="260" Click="PlayDirectUrl" />
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="22" Margin="0,18,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="This path measures" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="• media open time and failures&#x0a;• buffering transitions&#x0a;• playback end and interruption&#x0a;• app memory usage"
                                           FontSize="19" LineHeight="31" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AddonsPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <TextBlock Text="One HTTPS manifest URL per line. Stream requests are isolated so one failed add-on does not block the others."
                                   FontSize="21" TextWrapping="Wrap" />
                        <TextBox x:Name="AddonUrlsBox" Header="Stream add-on manifests" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="230" />
                        <Button Content="Save add-ons" Style="{StaticResource PrimaryButtonStyle}"
                                Width="230" Click="SaveAddons" />
                        <TextBlock x:Name="AddonSaveStatus" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ServerPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Width="38" Height="38" Stretch="Uniform" AutomationProperties.Name="Stremio Service">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/StremioSymbol.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Connect your Stremio server" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Your server handles torrent-backed playback. Enter its network address below."
                                   FontSize="19" TextWrapping="Wrap" />
                        <TextBox x:Name="StreamingServiceUrlBox" Header="Streaming service URL"
                                 PlaceholderText="http://192.168.1.103:32768/" />
                        <Button x:Name="ConnectServerButton" Content="Connect and save" Style="{StaticResource PrimaryButtonStyle}"
                                Width="290" Click="SaveStreamingService" />
                        <TextBlock x:Name="StreamingServiceStatus" FontSize="18"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <Button Content="Disconnect server" Style="{StaticResource TvButtonStyle}" Click="DisconnectServer" />
                        <TextBlock Text="Keep Stremio running on your server device and connect your Xbox to the same network. Choose a title, then Find streams to start watching." FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <StackPanel x:Name="SignedOutAccountContent" Spacing="18">
                            <TextBlock Text="Connect directly to Stremio at api.strem.io. Your password is sent only to Stremio for login; the returned session key is stored in Windows Credential Locker and verified when the app starts."
                                       FontSize="20" TextWrapping="Wrap" />
                            <Button Content="Continue with Facebook" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="300" Click="SignInWithFacebook" />
                            <TextBlock Text="Facebook sign-in opens Stremio's secure sign-in page in Microsoft Edge. Finish there, then return to this app. Your Facebook password is never entered into this app."
                                       FontSize="20" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Or sign in with email" FontSize="20" FontWeight="SemiBold" />
                            <TextBox x:Name="AccountEmailBox" Header="Stremio email" InputScope="EmailSmtpAddress" />
                            <PasswordBox x:Name="AccountPasswordBox" Header="Password" />
                            <Button Content="Sign in and sync" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="240" Click="SignInAndSync" />
                        </StackPanel>
                        <StackPanel x:Name="SignedInProfileContent" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="Your Stremio profile" FontSize="26" FontWeight="SemiBold" />
                            <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ProfileEmailText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProfileIdText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProfileAddonCountText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                            <Button x:Name="SyncAddonsButton" Content="Sync add-ons" Style="{StaticResource TvButtonStyle}"
                                    Width="210" Click="SyncAccountAddons" />
                            <Button Content="Sign out" Style="{StaticResource TvButtonStyle}"
                                    Width="160" Click="SignOut" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="AccountStatusBanner" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10">
                            <TextBlock x:Name="AccountStatusText" Text="Not signed in" FontSize="19"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                        <TextBlock x:Name="MemoryText" Text="Memory: measuring…" FontFamily="Consolas" FontSize="18" />
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Diagnostics}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="18"
                                           TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Page>
