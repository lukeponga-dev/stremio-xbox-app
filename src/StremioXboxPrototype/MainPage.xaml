<Page
    x:Class="StremioXboxPrototype.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StremioXboxPrototype.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="PosterTemplate">
            <controls:PosterCard Item="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="SkeletonTemplate">
            <StackPanel Width="240" Padding="12,14,12,0" Spacing="18" Height="446" AutomationProperties.Name="Loading title">
                <Border Height="324" CornerRadius="14" Background="{StaticResource PanelHoverBrush}" />
                <Border Height="20" Width="160" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource PanelBrush}" />
                <Border Height="14" Width="110" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource PanelBrush}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" XYFocusKeyboardNavigation="Enabled" KeyDown="MainPageKeyDown" SizeChanged="ViewportSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarSurface" Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="13.5,31,13.5,26"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="BrandHomeButton" Grid.Row="0" Style="{StaticResource IconRailBrandButtonStyle}"
                        Click="ShowHome" ToolTipService.ToolTip="WatchStream Home" AutomationProperties.Name="WatchStream Home">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="44" Height="44" Stretch="Uniform" />
                </Button>
                <ScrollViewer Grid.Row="1" Margin="0,29,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <Button x:Name="HomeButton" Style="{StaticResource SelectedIconRailButtonStyle}" Click="ShowHome"
                                ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="25" />
                        </Button>
                        <Button x:Name="DiscoverButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowDiscover"
                                ToolTipService.ToolTip="Discover" AutomationProperties.Name="Discover">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="25" />
                        </Button>
                        <Button x:Name="LibraryNavButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowLibrary"
                                ToolTipService.ToolTip="Library" AutomationProperties.Name="Library">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="25" />
                        </Button>
                        <Button x:Name="AddonsButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowAddons"
                                ToolTipService.ToolTip="Add-ons" AutomationProperties.Name="Add-ons">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="25" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="14">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconRailButtonStyle}" Click="ShowSettings"
                            ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="25" />
                    </Button>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="8" HorizontalAlignment="Center">
                        <StackPanel Spacing="7" AutomationProperties.Name="A Select, B Back, Y Search">
                            <TextBlock Text="A" Style="{StaticResource ControllerHintTextStyle}" />
                            <TextBlock Text="B" Style="{StaticResource ControllerHintTextStyle}" />
                            <TextBlock Text="Y" Style="{StaticResource ControllerHintTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ContentSurface" Grid.Column="1" Background="{StaticResource HomeSurfaceBrush}" Padding="48,36,65,51">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="MainHeader" Margin="0,0,0,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HeaderActionsColumn" Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderText" Spacing="6" Margin="0,0,24,0">
                    <TextBlock x:Name="PageTitle" Text="Home" FontFamily="{StaticResource HeadingFont}" FontSize="36" LineHeight="48" CharacterSpacing="-20" FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitle" Text="Pick up where you left off or find your next favourite" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                    <ProgressRing x:Name="BusyIndicator" Width="28" Height="28" IsActive="False" />
                    <Button x:Name="HomeRefreshButton" Style="{StaticResource HomeHeaderButtonStyle}" Click="RetryHome" AutomationProperties.Name="Refresh popular titles">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="20" /><TextBlock Text="Refresh" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="HeaderSearchButton" Style="{StaticResource HomeHeaderButtonStyle}" Click="ShowDiscover" AutomationProperties.Name="Open search">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="20" /><TextBlock Text="Search" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="AccountButton" Style="{StaticResource HomeHeaderButtonStyle}" Click="ShowAccount">
                        <Grid>
                            <TextBlock x:Name="AccountNavLabel" Text="Login" Margin="0,0,28,0" VerticalAlignment="Center" />
                            <Border x:Name="ProfileInitialBadge" Width="23" Height="23" CornerRadius="12" HorizontalAlignment="Right" Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="ProfileInitialText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid x:Name="HomePanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="HomeConnectionNotice" Visibility="Collapsed" Style="{StaticResource SurfaceBorderStyle}" Padding="12,4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="HomeConnectionText" Text="Playback server offline"
                                       FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Details" Style="{StaticResource HeaderButtonStyle}" Click="ShowConnectionDetails" />
                                <Button x:Name="HomeReconnectButton" Content="Reconnect" Style="{StaticResource HeaderButtonStyle}" Click="ReconnectServer" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="HomeShelves" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel Spacing="24">
                                <StackPanel x:Name="ContinueWatchingShelf" Visibility="Collapsed" Margin="0,0,0,30">
                                    <TextBlock Text="Continue Watching" Style="{StaticResource HomeSectionTitleStyle}" />
                                    <GridView x:Name="ContinueWatchingGrid" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource HorizontalItemsPanel}" ItemTemplate="{StaticResource PosterTemplate}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Margin="0,0,12,0">
                                        <TextBlock Text="Popular movies" Style="{StaticResource HomeSectionTitleStyle}" />
                                        <Button Content="See all ›" Width="120" HorizontalAlignment="Right" Style="{StaticResource ShelfLinkButtonStyle}" Click="ShowMovieCatalog" />
                                    </Grid>
                                    <GridView x:Name="MovieGrid" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource HorizontalItemsPanel}" ItemTemplate="{StaticResource PosterTemplate}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Margin="0,0,12,0">
                                        <TextBlock Text="Popular series" Style="{StaticResource HomeSectionTitleStyle}" />
                                        <Button Content="See all ›" Width="120" HorizontalAlignment="Right" Style="{StaticResource ShelfLinkButtonStyle}" Click="ShowSeriesCatalog" />
                                    </Grid>
                                    <GridView x:Name="SeriesGrid" SizeChanged="ShelfSizeChanged" ContainerContentChanging="PosterContainerChanging"
                                              IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None"
                                              ItemsPanel="{StaticResource HorizontalItemsPanel}" ItemTemplate="{StaticResource PosterTemplate}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="HomeLoadingPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="24">
                                <TextBlock Text="Finding something good to watch…" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel>
                                    <TextBlock Text="Popular movies" Style="{StaticResource SectionTitleStyle}" />
                                    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="MovieSkeletons" ItemTemplate="{StaticResource SkeletonTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Popular series" Style="{StaticResource SectionTitleStyle}" />
                                    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="SeriesSkeletons" ItemTemplate="{StaticResource SkeletonTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel x:Name="HomeUnavailablePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" MaxWidth="660">
                            <TextBlock x:Name="HomeStateTitle" Text="We couldn't load your movies and series" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="HomeStateText" Text="Check your internet connection, then try again." FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            <Button Content="Try again" Style="{StaticResource PrimaryButtonStyle}" Click="RetryHome" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid x:Name="DiscoverPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SearchInputGrid">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search movies and series" KeyDown="SearchBoxKeyDown" AutomationProperties.Name="Search movies and series" InputScope="Search" />
                        <Button x:Name="SearchSubmitButton" Grid.Column="1" Content="Search" Margin="12,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Search" />
                        <Button x:Name="KeyboardButton" Grid.Column="2" Width="60" Margin="12,0,0,0" Style="{StaticResource SearchToolButtonStyle}" Click="ToggleSearchKeyboard" AutomationProperties.Name="On-screen keyboard" ToolTipService.ToolTip="On-screen keyboard">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE765;" FontSize="23" />
                        </Button>
                        <Button x:Name="VoiceSearchButton" Grid.Column="3" Width="60" Margin="12,0,0,0" Style="{StaticResource SearchToolButtonStyle}" Click="VoiceSearch" AutomationProperties.Name="Voice search" ToolTipService.ToolTip="Voice search">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;" FontSize="23" />
                        </Button>
                    </Grid>
                    <Border x:Name="SearchKeyboardPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource SurfaceBorderStyle}" Padding="12" Margin="0,16,0,0" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="KeyboardRows" Spacing="6" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="DiscoverStatusText" Grid.Row="2" Text="Type a title, use the on-screen keyboard, or choose Voice." FontSize="18" Margin="0,16,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    <ScrollViewer x:Name="DiscoverSuggestions" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="16" Margin="0,22,0,0">
                        <TextBlock Text="Browse popular titles" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Choose a collection or search for a title." FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel x:Name="DiscoverBrowseActions" Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                            <Button Content="Popular movies  ›" Style="{StaticResource TvButtonStyle}" Click="ShowMovieCatalog" />
                            <Button Content="Popular series  ›" Style="{StaticResource TvButtonStyle}" Click="ShowSeriesCatalog" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                    <GridView x:Name="DiscoverGrid" Grid.Row="3" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="OpenItem" SelectionMode="None" ContainerContentChanging="PosterContainerChanging" ItemTemplate="{StaticResource PosterTemplate}" />
                </Grid>
                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,0,16">
                        <TextBlock Text="Local library" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Your saved movies and series"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="18" />
                    </StackPanel>
                    <GridView x:Name="LibraryGrid" ContainerContentChanging="PosterContainerChanging" Margin="0,58,0,0" IsItemClickEnabled="True" ItemClick="OpenItem"
                              SelectionMode="None" ItemTemplate="{StaticResource PosterTemplate}" />
                    <TextBlock x:Name="EmptyLibraryText" Text="Your library is empty. Open a title and choose Add to library." TextWrapping="Wrap"
                               FontSize="22" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer x:Name="PlaybackLabPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <TextBlock Text="Exercise the native Xbox media pipeline with a direct HTTP(S) URL."
                                   FontSize="22" TextWrapping="Wrap" />
                        <TextBox x:Name="DirectUrlBox" Header="Media URL"
                                 Text="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" />
                        <Button Content="Play direct stream" Style="{StaticResource PrimaryButtonStyle}"
                                Width="260" Click="PlayDirectUrl" />
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="22" Margin="0,18,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="This path measures" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="• media open time and failures&#x0a;• buffering transitions&#x0a;• playback end and interruption&#x0a;• app memory usage"
                                           FontSize="19" LineHeight="31" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="AddonsPanel" Visibility="Collapsed" Background="#0F0E18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Addons" FontFamily="{StaticResource HeadingFont}" FontSize="38" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Grid x:Name="AddonTopActions" Grid.Row="1" Margin="0,0,0,18" RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="AddonSyncAccountButton" Content="Sync Addons" Style="{StaticResource TvButtonStyle}" Click="SyncAddonsFromPage" HorizontalAlignment="Left" />
                        <Button x:Name="AddProviderButton" Grid.Column="1" Content="Import Manifest" Style="{StaticResource PrimaryButtonStyle}" Click="ToggleAddProviderForm" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">
                            <Border x:Name="AddProviderForm" Visibility="Collapsed" Background="#1B1A2B" BorderBrush="#3C3951" BorderThickness="1" CornerRadius="14" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Import stream add-on manifest" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="Paste HTTPS Stremio manifest URLs. Providers are validated before they are saved." FontSize="16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <TextBox x:Name="AddonUrlsBox" Header="Manifest URLs" PlaceholderText="https://example.com/manifest.json" AcceptsReturn="True" TextWrapping="Wrap" Height="130" />
                                    <StackPanel x:Name="AddonImportActions" Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="SaveProvidersButton" Content="Import providers" Style="{StaticResource PrimaryButtonStyle}" Click="SaveAddons" />
                                        <Button x:Name="SyncProvidersButton" Content="Sync from Stremio account" Style="{StaticResource TvButtonStyle}" Click="ShowAccount" />
                                    </StackPanel>
                                    <TextBlock x:Name="AddonSaveStatus" FontSize="16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#171623" BorderBrush="#393747" BorderThickness="1" CornerRadius="14" Padding="20,18">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Installed Addons" FontSize="23" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AddonCountText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
                                    </StackPanel>
                                    <TextBlock x:Name="AddonSummaryText" FontSize="16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <Grid x:Name="AddonGridHost" SizeChanged="AddonGridSizeChanged" Loaded="AddonGridHostLoaded">
                                    <GridView x:Name="AddonCards" IsItemClickEnabled="True" ItemClick="AddonTileClicked" SelectionMode="None"
                                              HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Loaded="AddonGridHostLoaded">
                                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="218" ItemHeight="224" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#242338" BorderBrush="#46435E" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,14,14" Height="204">
                                                    <StackPanel Spacing="7">
                                                        <Border Height="139" Background="#32304B" CornerRadius="10">
                                                            <Grid>
                                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7FC;" FontSize="54" Foreground="#CFB9FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding LogoSource}" Stretch="Uniform" Margin="10" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{Binding Category}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                    </Grid>
                                    <TextBlock x:Name="AddonEmptyDetail" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer x:Name="ServerPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="22">
                        <TextBlock Text="Streaming" FontSize="32" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="30" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Caching" FontSize="20" VerticalAlignment="Center" />
                            <ComboBox x:Name="StreamingCacheCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="StreamingCacheChanged" AutomationProperties.Name="Caching">
                                <ComboBoxItem Content="512MB" />
                                <ComboBoxItem Content="1GB" />
                                <ComboBoxItem Content="2GB" />
                                <ComboBoxItem Content="4GB" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Enable the local files add-on (requires restart)" FontSize="20"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="LocalFilesAddonToggle" Grid.Row="1" Grid.Column="1"
                                          HorizontalAlignment="Left" Toggled="LocalFilesAddonChanged"
                                          AutomationProperties.Name="Enable local files add-on" />

                            <TextBlock Grid.Row="2" Text="Enable remote HTTPS connections" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="RemoteHttpsCombo" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="RemoteHttpsChanged" AutomationProperties.Name="Remote HTTPS connections">
                                <ComboBoxItem Content="Disabled" />
                                <ComboBoxItem Content="Enabled" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Torrent Profile" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="TorrentProfileCombo" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="TorrentProfileChanged" AutomationProperties.Name="Torrent profile">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="Fast start" />
                                <ComboBoxItem Content="Data saver" />
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Server" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServerConnectionState" Grid.Row="4" Grid.Column="1" Text="Checking…" FontSize="20"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Text="Streaming server URL:" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="StreamingServerUrlText" Grid.Row="5" Grid.Column="1" TextTrimming="CharacterEllipsis"
                                       FontSize="18" VerticalAlignment="Center" />
                            <Button Grid.Row="5" Grid.Column="2" Content="Copy" Style="{StaticResource TvButtonStyle}"
                                    Click="CopyStreamingServerUrl" AutomationProperties.Name="Copy streaming server URL" />
                        </Grid>

                        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Playback server" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Your server handles torrent-backed playback. Render-hosted servers should use the public HTTPS URL without port 12470."
                                           FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="StreamingServiceUrlBox" Header="Streaming service URL"
                                         PlaceholderText="https://watchstream-stremio-server.onrender.com/" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button x:Name="ConnectServerButton" Content="Connect and save" Style="{StaticResource PrimaryButtonStyle}"
                                            Width="230" Click="SaveStreamingService" />
                                    <Button Content="Disconnect server" Style="{StaticResource TvButtonStyle}" Click="DisconnectServer" />
                                </StackPanel>
                                <TextBlock x:Name="StreamingServiceStatus" FontSize="18"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <StackPanel x:Name="SignedOutAccountContent" Spacing="18">
                            <TextBlock Text="Connect directly to Stremio at api.strem.io. Your password is sent only to Stremio for login; the returned session key is stored in Windows Credential Locker and verified when the app starts."
                                       FontSize="20" TextWrapping="Wrap" />
                            <Button Content="Continue with Facebook" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="300" Click="SignInWithFacebook" />
                            <TextBlock Text="Facebook sign-in opens Stremio's secure sign-in page in Microsoft Edge. Finish there, then return to this app. Your Facebook password is never entered into this app."
                                       FontSize="20" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Or sign in with email" FontSize="20" FontWeight="SemiBold" />
                            <TextBox x:Name="AccountEmailBox" Header="Stremio email" InputScope="EmailSmtpAddress" />
                            <PasswordBox x:Name="AccountPasswordBox" Header="Password" />
                            <Button Content="Sign in and sync" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="240" Click="SignInAndSync" />
                        </StackPanel>
                        <StackPanel x:Name="SignedInProfileContent" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="Your Stremio profile" FontSize="26" FontWeight="SemiBold" />
                            <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ProfileEmailText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProfileIdText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProfileAddonCountText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                            <Button x:Name="SyncAddonsButton" Content="Sync add-ons" Style="{StaticResource TvButtonStyle}"
                                    Width="210" Click="SyncAccountAddons" />
                            <Button Content="Sign out" Style="{StaticResource TvButtonStyle}"
                                    Width="160" Click="SignOut" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="AccountStatusBanner" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10">
                            <TextBlock x:Name="AccountStatusText" Text="Not signed in" FontSize="19"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <TextBlock Text="Display and accessibility" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch x:Name="PosterAnimationsToggle" Header="Animate focused posters" OnContent="4% focus zoom" OffContent="Border only" Toggled="PosterAnimationsChanged" FontSize="20" />
                        <TextBlock Text="Turn off zoom animations if you prefer less motion. The bright focus border remains visible." FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <Button Content="Manage Stremio account" Style="{StaticResource TvButtonStyle}" Click="ShowAccount" />
                        <TextBlock Text="Advanced" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Manage your playback server and troubleshooting tools." FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="ServerButton" Content="Playback server" Style="{StaticResource TvButtonStyle}" Click="ShowServer" />
                        <Button x:Name="PlaybackLabButton" Content="Playback Lab" Style="{StaticResource TvButtonStyle}" Click="ShowPlaybackLab" />
                        <Button x:Name="DiagnosticsButton" Content="Diagnostics" Style="{StaticResource TvButtonStyle}" Click="ShowDiagnostics" />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                        <StackPanel Spacing="12"><TextBlock x:Name="MemoryText" Text="Memory: measuring…" FontFamily="Consolas" FontSize="18" /><TextBlock x:Name="NetworkStatusText" Text="Ready" FontSize="18" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Diagnostics}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="18"
                                           TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Page>
