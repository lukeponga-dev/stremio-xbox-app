<Page
    x:Class="StremioXboxPrototype.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black" XYFocusKeyboardNavigation="Enabled" KeyDown="PlayerPageKeyDown" SizeChanged="ViewportSizeChanged">
        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"
                            AutoPlay="True" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid x:Name="LoadingArtwork" Background="#0D0D0F" IsHitTestVisible="False">
            <Image x:Name="LoadingBackdrop" Stretch="UniformToFill" Opacity="0.45" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700" Spacing="24">
                <TextBlock x:Name="LoadingTitle" FontFamily="{StaticResource HeadingFont}" FontSize="44" CharacterSpacing="-20" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressRing x:Name="ArtworkSpinner" IsActive="True" Width="40" Height="40" />
            </StackPanel>
        </Grid>
        <Button x:Name="BackSourcesButton" Content="Back to sources" Click="BackToSources" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="48,16" AutomationProperties.Name="Back to sources" />

        <Border x:Name="StatusOverlay" Background="{StaticResource GlassBrush}" BorderBrush="#2600AFFF"
                BorderThickness="1" CornerRadius="16" Padding="24"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,80,48,32" MaxWidth="760">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="NOW PLAYING" FontSize="16" FontWeight="SemiBold" CharacterSpacing="100"
                               Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,5" />
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource HeadingFont}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Margin="0,12,0,0" />
            <TextBlock x:Name="StatusText" Text="Opening media…" FontSize="20" Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="ControllerHintSurface" Background="#C6080A12" CornerRadius="10" Padding="14,8" Margin="48,32"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock x:Name="ControllerHintText" Text="Use the Xbox controller to show playback controls   Y  Audio / Subtitles / Speed   B  Back" FontSize="16" TextWrapping="Wrap"
                       FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
        </Border>

        <Border x:Name="PlaybackControls" Background="#E6101724" BorderBrush="#6600AFFF"
                BorderThickness="1" CornerRadius="18" Padding="28,20" Margin="48,32"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="Collapsed">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="White" />
                    <Slider x:Name="PlaybackProgressSlider" Grid.Column="1" Minimum="0" Maximum="100"
                            Value="0" VerticalAlignment="Center" IsEnabled="False" MinHeight="48"
                            IsTabStop="True" XYFocusDown="{x:Bind PlayPauseButton}"
                            GotFocus="PlaybackProgressGotFocus" LostFocus="PlaybackProgressLostFocus"
                            ValueChanged="PlaybackProgressValueChanged"
                            AutomationProperties.Name="Playback position" />
                    <TextBlock x:Name="DurationTimeText" Grid.Column="2" Text="0:00" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <Button x:Name="RewindButton" Content="−10 sec" Click="RewindClicked"
                            MinWidth="132" MinHeight="64" FontSize="18" FontWeight="SemiBold"
                            XYFocusLeft="{x:Bind MuteButton}" XYFocusRight="{x:Bind PlayPauseButton}" XYFocusUp="{x:Bind PlaybackProgressSlider}"
                            AutomationProperties.Name="Rewind 10 seconds" />
                    <Button x:Name="PlayPauseButton" Content="Pause" Click="PlayPauseClicked"
                            MinWidth="156" MinHeight="68" FontSize="21" FontWeight="Bold"
                            Background="{StaticResource AccentBrush}" Foreground="Black"
                            XYFocusLeft="{x:Bind RewindButton}" XYFocusRight="{x:Bind ForwardButton}"
                            XYFocusUp="{x:Bind PlaybackProgressSlider}"
                            AutomationProperties.Name="Play or pause" />
                    <Button x:Name="ForwardButton" Content="+10 sec" Click="ForwardClicked"
                            MinWidth="132" MinHeight="64" FontSize="18" FontWeight="SemiBold"
                            XYFocusLeft="{x:Bind PlayPauseButton}" XYFocusRight="{x:Bind MuteButton}"
                            XYFocusUp="{x:Bind PlaybackProgressSlider}"
                            AutomationProperties.Name="Forward 10 seconds" />
                    <Button x:Name="MuteButton" Content="Mute" Click="MuteClicked"
                            MinWidth="112" MinHeight="64" FontSize="18" FontWeight="SemiBold"
                            XYFocusLeft="{x:Bind ForwardButton}" XYFocusRight="{x:Bind RewindButton}" XYFocusUp="{x:Bind PlaybackProgressSlider}"
                            AutomationProperties.Name="Mute or unmute" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="PlaybackOptionsPanel" Background="#F0101724" BorderBrush="#9900AFFF"
                BorderThickness="2" CornerRadius="18" Padding="24" Margin="48"
                Width="520" MaxHeight="820" HorizontalAlignment="Right" VerticalAlignment="Center"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="PLAYBACK OPTIONS" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock Text="AUDIO TRACK" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel x:Name="AudioTrackOptions" Spacing="6" />
                    <TextBlock Text="SUBTITLES" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                    <StackPanel x:Name="SubtitleTrackOptions" Spacing="6" />
                    <TextBlock Text="PLAYBACK SPEED" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                    <StackPanel x:Name="PlaybackSpeedOptions" Orientation="Horizontal"
                                HorizontalAlignment="Left" Spacing="8" />
                    <TextBlock Text="A  Select     B  Close     Y  Options"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
