<Page
    x:Class="StremioXboxPrototype.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black" XYFocusKeyboardNavigation="Enabled" KeyDown="PlayerPageKeyDown">
        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"
                            AutoPlay="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Border x:Name="StatusOverlay" Background="#EC0E101A" BorderBrush="#458F5BFF"
                BorderThickness="1" CornerRadius="14" Padding="20,18"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,32" MaxWidth="760">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="NOW PLAYING" FontSize="16" FontWeight="SemiBold" CharacterSpacing="100"
                               Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,5" />
                    <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Opening media…" FontSize="20" Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="#C6080A12" CornerRadius="10" Padding="14,8" Margin="48,32"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock x:Name="ControllerHintText" Text="B  Back     X  Mute" FontSize="20"
                       FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
        </Border>
    </Grid>
</Page>
