<Page
    x:Class="StremioXboxPrototype.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black" XYFocusKeyboardNavigation="Enabled">
        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"
                            AutoPlay="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Border x:Name="StatusOverlay" Background="#D9071019" CornerRadius="8" Padding="18"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36" MaxWidth="720">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Opening media…" FontSize="17" Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
