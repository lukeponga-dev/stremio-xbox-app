<UserControl
    x:Class="StremioXboxPrototype.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" Width="240" Height="450">
    <Grid Padding="0,0,20,10">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PosterRow" Height="324" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="PosterFrame" Width="216" Height="324" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="PosterScale" /></Grid.RenderTransform>
            <Border x:Name="FocusGlow" Margin="-5" CornerRadius="20" Background="{StaticResource FocusBloomBrush}" Opacity="0" />
            <Border x:Name="Artwork" CornerRadius="16" BorderThickness="1" BorderBrush="#14FFFFFF" Background="{StaticResource PanelBrush}">
                <TextBlock x:Name="FallbackTitle" TextWrapping="Wrap" TextAlignment="Center" FontSize="22"
                           VerticalAlignment="Center" Margin="16" Foreground="{StaticResource MutedTextBrush}" />
            </Border>
            <Border x:Name="ResumingBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16" Padding="10,6" CornerRadius="6" Background="#CC25212C">
                <TextBlock Text="RESUMING" FontSize="12" FontWeight="Bold" CharacterSpacing="80"
                           Foreground="{StaticResource AccentTextBrush}" />
            </Border>
            <ProgressBar x:Name="WatchProgressBar" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="10,0,10,12"
                         Height="7" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#CC100E20" />
        </Grid>
        <TextBlock x:Name="TitleText" Grid.Row="1" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,6" MinHeight="36"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
        <StackPanel x:Name="FocusDetails" Grid.Row="2" Spacing="3" Visibility="Collapsed">
            <TextBlock x:Name="MetadataText" FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="TypeText" FontSize="18" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentTextBrush}" />
        </StackPanel>
        <Border x:Name="FocusOutline" Grid.RowSpan="3" Margin="-8,-10,-8,-6" CornerRadius="18"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="4" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</UserControl>
