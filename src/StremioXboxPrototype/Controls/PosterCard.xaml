<UserControl x:Class="StremioXboxPrototype.Controls.PosterCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="False" Width="300" Height="214">
    <Grid Padding="0,0,12,10">
        <Grid.RowDefinitions><RowDefinition Height="170" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="PosterFrame" Width="288" Height="162" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="PosterScale" /></Grid.RenderTransform>
            <Border x:Name="FocusGlow" Margin="-5" CornerRadius="13" Background="{StaticResource FocusBloomBrush}" Opacity="0" />
            <Border x:Name="Artwork" CornerRadius="10" BorderThickness="1" BorderBrush="#263648" Background="{StaticResource PanelBrush}">
                <TextBlock x:Name="FallbackTitle" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" VerticalAlignment="Center" Margin="12" Foreground="{StaticResource MutedTextBrush}" />
            </Border>
            <Border VerticalAlignment="Bottom" Height="62" CornerRadius="0,0,10,10">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101824" Offset="0" /><GradientStop Color="#F0101824" Offset="1" /></LinearGradientBrush></Border.Background>
            </Border>
            <TextBlock x:Name="TitleText" VerticalAlignment="Bottom" Margin="12,0,10,9" FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <Border x:Name="ResumingBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="7,4" CornerRadius="5" Background="#CC0B1420">
                <TextBlock Text="CONTINUE" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="#DCEBFA" />
            </Border>
            <ProgressBar x:Name="WatchProgressBar" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="10,0,10,3" Height="4" Minimum="0" Maximum="100" Foreground="#1684FF" Background="#995B6878" />
            <Border x:Name="FocusOutline" Margin="-3" CornerRadius="12" BorderBrush="#1684FF" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel x:Name="FocusDetails" Grid.Row="1" Spacing="2" Visibility="Collapsed">
            <TextBlock x:Name="MetadataText" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="TypeText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>