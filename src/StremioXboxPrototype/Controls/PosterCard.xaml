<UserControl
    x:Class="StremioXboxPrototype.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" Width="240" Height="446">
    <Grid Padding="12,14,12,0">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PosterRow" Height="324" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="PosterFrame" Width="216" Height="324" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="PosterScale" /></Grid.RenderTransform>
            <Border x:Name="FocusGlow" Margin="-5" CornerRadius="20" Background="#607650F5" Opacity="0" />
            <Border x:Name="Artwork" CornerRadius="14" Background="{StaticResource PanelBrush}">
                <TextBlock x:Name="FallbackTitle" TextWrapping="Wrap" TextAlignment="Center" FontSize="22"
                           VerticalAlignment="Center" Margin="16" Foreground="{StaticResource MutedTextBrush}" />
            </Border>
            <Border x:Name="FocusOutline" CornerRadius="14" BorderBrush="White" BorderThickness="3" Opacity="0" />
        </Grid>
        <TextBlock x:Name="TitleText" Grid.Row="1" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,6"
                   TextTrimming="CharacterEllipsis" MaxLines="1" />
        <StackPanel x:Name="FocusDetails" Grid.Row="2" Spacing="3" Opacity="0">
            <TextBlock x:Name="MetadataText" FontSize="16" Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Text="Cinemeta · Find streams" FontSize="15" Foreground="{StaticResource AccentTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
