<Page
    x:Class="StremioXboxPrototype.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid XYFocusKeyboardNavigation="Enabled">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.36" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FA080A12" Offset="0" />
                    <GradientStop Color="#E6080A12" Offset="0.55" />
                    <GradientStop Color="#F2080A12" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Padding="42,32,42,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource SurfaceBorderStyle}" CornerRadius="12" Width="242" Height="348"
                    VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="2">
                <Image x:Name="Poster" Stretch="UniformToFill" />
            </Border>

            <ScrollViewer Grid.Column="1" Margin="28,0,0,0">
                <StackPanel Spacing="11">
                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="11,5" HorizontalAlignment="Left">
                        <TextBlock Text="STREMIO TITLE" FontSize="9" FontWeight="SemiBold" CharacterSpacing="100"
                                   Foreground="{StaticResource AccentTextBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="SubtitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock x:Name="DescriptionText" FontSize="17" LineHeight="25" TextWrapping="Wrap" MaxWidth="860"
                               HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="11" Margin="0,8,0,6">
                        <Button x:Name="LoadStreamsButton" Content="Find streams" Style="{StaticResource PrimaryButtonStyle}"
                                Width="190" Click="LoadStreams" />
                        <Button x:Name="LibraryButton" Content="Add to library" Style="{StaticResource TvButtonStyle}"
                                Width="190" Click="ToggleLibrary" />
                    </StackPanel>
                    <ComboBox x:Name="EpisodePicker" Header="Choose episode" FontSize="16" MinWidth="370"
                              DisplayMemberPath="DisplayTitle" SelectionChanged="EpisodeChanged" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <ProgressRing x:Name="BusyIndicator" Width="32" Height="32" />
                        <TextBlock x:Name="StreamStatusText" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="StreamList" IsItemClickEnabled="True" ItemClick="OpenStream" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceBorderStyle}" Padding="15,12" Margin="0,4" MinWidth="590">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="207" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="11"
                                                Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResolutionLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="18" Margin="0,16,0,0">
                <TextBlock Text="B  Back" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="A  Select" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
