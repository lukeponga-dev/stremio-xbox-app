<Page
    x:Class="StremioXboxPrototype.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid XYFocusKeyboardNavigation="Enabled" SizeChanged="ViewportSizeChanged">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.36" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FA0D0D0F" Offset="0" />
                    <GradientStop Color="#BF0D0D0F" Offset="0.55" />
                    <GradientStop Color="#F20D0D0F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="DetailsContent" Padding="48,27">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PosterColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="PosterSurface" Style="{StaticResource SurfaceBorderStyle}" CornerRadius="14" Width="220" Height="330"
                    VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="2">
                <Image x:Name="Poster" Stretch="UniformToFill" />
            </Border>

            <ScrollViewer x:Name="DetailsScroll" Grid.Column="1" Margin="24,0,0,0"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="13,6" HorizontalAlignment="Left">
                        <TextBlock Text="STREMIO TITLE" FontSize="16" FontWeight="SemiBold" CharacterSpacing="100"
                                   Foreground="{StaticResource AccentTextBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource HeadingFont}" FontSize="48" CharacterSpacing="-20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="SubtitleText" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText" FontSize="20" LineHeight="30" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="LoadStreamsButton" Content="Refresh streams" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,7,0" Click="LoadStreams" />
                        <Button x:Name="LibraryButton" Content="Add to library" Style="{StaticResource TvButtonStyle}"
                                Grid.Column="1" HorizontalAlignment="Stretch" Margin="7,0,0,0" Click="ToggleLibrary" />
                    </Grid>
                    <ComboBox x:Name="EpisodePicker" Header="Choose episode" FontSize="19" HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayTitle" SelectionChanged="EpisodeChanged" Visibility="Collapsed" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ProgressRing x:Name="BusyIndicator" Width="38" Height="38" Margin="0,0,14,0" />
                        <TextBlock x:Name="StreamStatusText" Grid.Column="1" FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="StreamList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="PlayStream" IsFocusEngagementEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16" Margin="0,5"
                                            HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding DisplayName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="13"
                                                    Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ResolutionLabel}" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                    </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24" Margin="0,20,0,0">
                <TextBlock Text="B  Back" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="A  Select" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
