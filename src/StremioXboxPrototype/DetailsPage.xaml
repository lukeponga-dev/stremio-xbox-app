<Page
    x:Class="StremioXboxPrototype.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid XYFocusKeyboardNavigation="Enabled">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.36" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FA080A12" Offset="0" />
                    <GradientStop Color="#E6080A12" Offset="0.55" />
                    <GradientStop Color="#F2080A12" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Padding="48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource SurfaceBorderStyle}" CornerRadius="14" Width="220" Height="330"
                    VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="2">
                <Image x:Name="Poster" Stretch="UniformToFill" />
            </Border>

            <ScrollViewer Grid.Column="1" Margin="24,0,0,0">
                <StackPanel Spacing="14">
                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="13,6" HorizontalAlignment="Left">
                        <TextBlock Text="STREMIO TITLE" FontSize="16" FontWeight="SemiBold" CharacterSpacing="100"
                                   Foreground="{StaticResource AccentTextBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="48" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="SubtitleText" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock x:Name="DescriptionText" FontSize="20" LineHeight="30" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,8">
                        <Button x:Name="LoadStreamsButton" Content="Find streams" Style="{StaticResource PrimaryButtonStyle}"
                                Width="230" Click="LoadStreams" />
                        <Button x:Name="LibraryButton" Content="Add to library" Style="{StaticResource TvButtonStyle}"
                                Width="230" Click="ToggleLibrary" />
                    </StackPanel>
                    <ComboBox x:Name="EpisodePicker" Header="Choose episode" FontSize="19" MinWidth="440"
                              DisplayMemberPath="DisplayTitle" SelectionChanged="EpisodeChanged" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ProgressRing x:Name="BusyIndicator" Width="38" Height="38" />
                        <TextBlock x:Name="StreamStatusText" FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="StreamList" IsItemClickEnabled="True" ItemClick="OpenStream" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16" Margin="0,5" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="13"
                                                Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResolutionLabel}" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24" Margin="0,20,0,0">
                <TextBlock Text="B  Back" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="A  Select" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
