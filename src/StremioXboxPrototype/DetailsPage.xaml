<Page
    x:Class="StremioXboxPrototype.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid XYFocusKeyboardNavigation="Enabled">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.23" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F2071019" Offset="0" />
                    <GradientStop Color="#D9071019" Offset="0.58" />
                    <GradientStop Color="#F2071019" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Padding="54,42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Width="250" Height="360"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <Image x:Name="Poster" Stretch="UniformToFill" />
            </Border>

            <ScrollViewer Grid.Column="1" Margin="34,0,0,0">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="TitleText" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" FontSize="20" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="DescriptionText" FontSize="21" LineHeight="31" TextWrapping="Wrap" MaxWidth="1050"
                               HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,6">
                        <Button x:Name="LibraryButton" Content="Add to library" Style="{StaticResource TvButtonStyle}"
                                Width="230" Click="ToggleLibrary" />
                        <Button x:Name="LoadStreamsButton" Content="Find streams" Style="{StaticResource PrimaryButtonStyle}"
                                Width="230" Click="LoadStreams" />
                    </StackPanel>
                    <ComboBox x:Name="EpisodePicker" Header="Episode" FontSize="19" MinWidth="420"
                              DisplayMemberPath="DisplayTitle" SelectionChanged="EpisodeChanged" Visibility="Collapsed" />
                    <ProgressRing x:Name="BusyIndicator" Width="48" Height="48" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StreamStatusText" FontSize="18" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <ListView x:Name="StreamList" IsItemClickEnabled="True" ItemClick="OpenStream" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="0,5" MinWidth="700">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="19" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding ResolutionLabel}" FontSize="17"
                                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="B  Back" FontSize="17"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,20,0,0" />
        </Grid>
    </Grid>
</Page>
