<Page
    x:Class="StremioXboxPrototype.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Grid Background="#08090E" XYFocusKeyboardNavigation="Enabled" SizeChanged="ViewportSizeChanged">
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.58" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC08090E" Offset="0" />
                    <GradientStop Color="#6608090E" Offset="0.48" />
                    <GradientStop Color="#F508090E" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="DetailsContent" Padding="48,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="300" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="27" Foreground="#8B6CFF" />
                    <TextBlock Text="OpenStream TV" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Discover  &gt;  Details" FontSize="16"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <Button x:Name="BackButton" Grid.Column="2" Content="Back" Style="{StaticResource TvButtonStyle}"
                        Click="GoBack" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Bottom" MaxWidth="1040" Spacing="9">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource HeadingFont}" FontSize="52"
                               FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="SubtitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="#E2D8FF" TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText" FontSize="17" LineHeight="23"
                               TextWrapping="Wrap" MaxLines="3" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Button x:Name="LoadStreamsButton" Content="Play" Style="{StaticResource PrimaryButtonStyle}"
                                Click="PlayFirstStream" />
                        <Button x:Name="LibraryButton" Content="Save to Watch Later" Style="{StaticResource TvButtonStyle}"
                                Click="ToggleLibrary" />
                    </StackPanel>
                    <ComboBox x:Name="EpisodePicker" Header="Choose episode" FontSize="17" Width="420"
                              HorizontalAlignment="Left" SelectionChanged="EpisodeChanged" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Text="About" FontSize="25" FontWeight="Bold" />
                    <Border Background="#E610121B" BorderBrush="#343544" BorderThickness="1"
                            CornerRadius="12" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Synopsis" FontSize="16" FontWeight="SemiBold" Foreground="#A99AFF" />
                            <TextBlock x:Name="AboutDescriptionText" FontSize="16" LineHeight="23"
                                       TextWrapping="Wrap" />
                            <Rectangle Height="1" Fill="#343544" />
                            <TextBlock x:Name="AboutMetadataText" FontSize="15" LineHeight="22"
                                       Foreground="#C2C3D0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Streams from Addons" FontSize="25" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="BusyIndicator" Width="28" Height="28" />
                        <TextBlock x:Name="StreamStatusText" Grid.Column="1" Margin="10,0,0,0"
                                   FontSize="15" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="StreamList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="PlayStream" IsFocusEngagementEnabled="False"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#F4F7FB">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E61B1D29" BorderBrush="#393B4C" BorderThickness="1"
                                        CornerRadius="12" Padding="12,10" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Provider}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="#C7D0DF" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#2865E9" CornerRadius="8"
                                                Padding="16,8" VerticalAlignment="Center">
                                            <TextBlock Text="Play" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="24" Margin="0,12,0,0">
                <TextBlock Text="B  Back" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="A  Select" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
