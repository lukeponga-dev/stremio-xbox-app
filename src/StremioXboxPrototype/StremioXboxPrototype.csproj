<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- The UWP XAML and MSIX targets also read the explicit platform version
         during command-line packaging. Keep it aligned with TargetFramework. -->
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseUwp>true</UseUwp>
    <Platforms>x64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <HotReloadEnabled>true</HotReloadEnabled>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Packaging certificates are developer-local and intentionally excluded
         from source control. Use Visual Studio's Publish flow to select one. -->
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <!-- UWP AppContainer launch can deny Visual Studio the process handle that
         its Hot Reload session requests. Disable the unsupported session path. -->
    <SupportsHotReload>false</SupportsHotReload>
    <RootNamespace>StremioXboxPrototype</RootNamespace>
    <AssemblyName>StremioXboxPrototype</AssemblyName>
    <UseWindowsForms>False</UseWindowsForms>
    <!-- Developer certificates stay outside source control. Sign automatically
         when one is present; Store builds are emitted unsigned and re-signed by
         Microsoft after acceptance. -->
    <!-- .csproj.user is imported after this property group, so its
         PackageCertificateKeyFile value cannot be used in this condition. -->
    <AppxPackageSigningEnabled Condition="Exists('StremioXboxPrototype_TemporaryKey.pfx')">true</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="!Exists('StremioXboxPrototype_TemporaryKey.pfx')">false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.5" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.49.0" />
    <PackageReference Include="Grpc.Tools" Version="2.49.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Client" Version="7.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NSwag.ApiDescription.Client" Version="13.18.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
