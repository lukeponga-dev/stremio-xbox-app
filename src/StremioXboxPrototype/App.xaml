<Application
    x:Class="StremioXboxPrototype.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080A12" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0E101A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#171A25" />
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#232738" />
        <SolidColorBrush x:Key="ElevatedPanelBrush" Color="#202431" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8F5BFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B2045" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#C9B5FF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A8B6" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2B3040" />

        <Style TargetType="Page">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="TvButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
            <Setter Property="FocusVisualMargin" Value="3" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="SelectedNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,11" />
        </Style>
        <Style x:Key="SurfaceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </Application.Resources>
</Application>
