<Application
    x:Class="StremioXboxPrototype.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="HeadingFont">ms-appx:///Assets/Fonts/Sora.ttf#Sora</FontFamily>
        <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Inter.ttf#Inter</FontFamily>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#131315" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#111116" />
        <LinearGradientBrush x:Key="HomeSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#111126" Offset="0" />
            <GradientStop Color="#0B0B0E" Offset="0.42" />
            <GradientStop Color="#17101F" Offset="0.72" />
            <GradientStop Color="#0B0B0E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PosterFallbackBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#94C2D8" Offset="0" />
            <GradientStop Color="#AA9BB1" Offset="0.46" />
            <GradientStop Color="#181416" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#201F21" />
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#353437" />
        <SolidColorBrush x:Key="ElevatedPanelBrush" Color="#2A2A2C" />
        <SolidColorBrush x:Key="SearchBarBrush" Color="#1B1B1D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7A3FFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#337A3FFF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#CFBDFF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#CBC3D9" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#33494456" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#3F7BFF" />
        <SolidColorBrush x:Key="LiveBrush" Color="#FF3EDB" />
        <SolidColorBrush x:Key="GlassBrush" Color="#BF0D0D0F" />
        <LinearGradientBrush x:Key="FocusBloomBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7A3FFF" Offset="0" />
            <GradientStop Color="#3F7BFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3F7BFF" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#390093" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3F7BFF" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        </Style>

        <Style TargetType="Page">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="TvButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
            <Setter Property="FocusVisualMargin" Value="3" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TvButtonStyle}" />
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="HomeHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#201F23" />
            <Setter Property="BorderBrush" Value="#3A3940" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="SearchToolButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyboardKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="168" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="SelectedNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="IconRailButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style x:Key="SelectedIconRailButtonStyle" TargetType="Button" BasedOn="{StaticResource IconRailButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="IconRailBrandButtonStyle" TargetType="Button" BasedOn="{StaticResource IconRailButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="ControllerHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AdvancedNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style x:Key="SelectedAdvancedNavButtonStyle" TargetType="Button" BasedOn="{StaticResource AdvancedNavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="ShelfLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="LineHeight" Value="36" />
            <Setter Property="CharacterSpacing" Value="-10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="LineHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SurfaceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Background" Value="{StaticResource SearchBarBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="CornerRadius" Value="16" />

            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="MinHeight" Value="60" />

            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        </Style>
        <Style TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        </Style>
    </Application.Resources>
</Application>
